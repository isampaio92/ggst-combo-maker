# Dependências (reconstruídas via npm install)
node_modules/

# Build de produção e caches de compilação (reconstruídos via npm run build)
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# Variáveis de ambiente e segredos locais (proibidos no projeto, bloqueados preventivamente)
.env
.env.*
!.env.example

# Chaves privadas, certificados e credenciais sensíveis
*.pem
*.key
*.crt
*.p12
*.pfx

# Logs de execução e depuração (apenas na raiz ou arquivos .log; preserva src/logs/)
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dumps, backups e arquivos temporários
*.bak
*.tmp
*.swp
*.swo
*~

# Sistema operacional
.DS_Store
Thumbs.db

# Configurações pessoais de editores e IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
