# Padronização automática de arquivos de texto para LF
* text=auto eol=lf

# Código-fonte TypeScript, React, HTML e CSS
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.html text eol=lf
*.css text eol=lf

# Arquivos de configuração e dados estruturados
*.json text eol=lf

# Documentação e arquivos de contexto
*.md text eol=lf
*.txt text eol=lf

# Imagens e recursos binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
